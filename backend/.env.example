PORT=5000
NODE_ENV=development

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mtech_repairs
DB_USER=root
DB_PASSWORD=your_mysql_password

# (Only needed for the one-time data migration script)
MONGO_URI=mongodb://127.0.0.1:27017/mtech_repairs

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - frontend origin
CLIENT_ORIGIN=http://localhost:5173

# Email (for booking / contact notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
NOTIFY_EMAIL=info@mtechrepairs.co.uk
